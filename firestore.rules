rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActiveUser() {
      return isVerifiedUser() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isBootstrappedSuperAdmin() {
      return isActiveUser() && request.auth.token.email == 'stephenmayowa112@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isOperationalAdmin() {
      return isSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operational_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isActivePartnerOwner(uid) {
      return isOwner(uid) && isActiveUser() && (
        !exists(/databases/$(database)/documents/partnerProfiles/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/partnerProfiles/$(request.auth.uid)).data.verificationStatus != 'suspended'
      );
    }

    function isApprovedPartner() {
      return isActiveUser() &&
        exists(/databases/$(database)/documents/partnerProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partnerProfiles/$(request.auth.uid)).data.verificationStatus == 'approved';
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringList(val, maxItems) {
      return val is list && val.size() <= maxItems && (val.size() == 0 || val[0] is string);
    }

    // --- Validation Blueprints ---
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'role', 'status', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'role', 'status', 'displayName', 'email', 'phone', 'mfaEnforced', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.role in ['customer', 'partner', 'operational_admin', 'super_admin']
        && data.status in ['active', 'pending_review', 'suspended', 'deactivated']
        && isValidString(data.displayName, 1, 120)
        && isValidString(data.email, 3, 254)
        && isValidOptionalString(data, 'phone', 30)
        && (!('mfaEnforced' in data) || data.mfaEnforced is bool)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidPartnerProfile(data) {
      return data.keys().hasAll(['ownerUid', 'partnerType', 'legalName', 'displayAttribution', 'email', 'phone', 'channelVerified', 'idType', 'privateIdDocRef', 'verificationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'partnerType', 'legalName', 'agencyName', 'displayAttribution', 'email', 'phone', 'channelVerified', 'idType', 'privateIdDocRef', 'verificationStatus', 'reviewNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.partnerType in ['agent', 'owner', 'manager']
        && isValidString(data.legalName, 2, 140)
        && isValidOptionalString(data, 'agencyName', 140)
        && isValidString(data.displayAttribution, 2, 80)
        && isValidString(data.email, 3, 254)
        && isValidString(data.phone, 7, 30)
        && data.channelVerified is bool
        && data.idType in ['nin_slip', 'international_passport', 'drivers_licence', 'pvc']
        && isValidString(data.privateIdDocRef, 3, 260)
        && data.verificationStatus in ['pending_review', 'more_info_requested', 'approved', 'rejected', 'suspended']
        && isValidOptionalString(data, 'reviewNotes', 1000)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidPrivateListing(data) {
      return data.keys().hasAll(['listingId', 'originatorUid', 'originatorDisplayName', 'category', 'status', 'title', 'summary', 'city', 'area', 'rateKobo', 'cautionFeeKobo', 'rentalBasis', 'featureIds', 'watermarkedPhotos', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['listingId', 'originatorUid', 'originatorDisplayName', 'category', 'status', 'title', 'summary', 'city', 'area', 'safeStreetLabel', 'exactBuildingNumber', 'propertyManagerPhone', 'vehicleOrVesselIdentifier', 'authorityEvidenceNote', 'rateKobo', 'cautionFeeKobo', 'rentalBasis', 'featureIds', 'rules', 'specs', 'watermarkedPhotos', 'privateOriginalMediaRefs', 'duplicateFlagIds', 'verifiedPropertyBadge', 'createdAt', 'updatedAt'])
        && isValidId(data.listingId)
        && isValidId(data.originatorUid)
        && isValidString(data.originatorDisplayName, 2, 80)
        && data.category in ['apartment', 'car', 'boat']
        && data.status in ['pending_review', 'approved', 'changes_requested', 'rejected', 'suspended']
        && isValidString(data.title, 4, 160)
        && isValidString(data.summary, 10, 2000)
        && isValidString(data.city, 2, 80)
        && isValidString(data.area, 2, 120)
        && isValidOptionalString(data, 'safeStreetLabel', 120)
        && isValidOptionalString(data, 'exactBuildingNumber', 120)
        && isValidOptionalString(data, 'propertyManagerPhone', 30)
        && isValidOptionalString(data, 'vehicleOrVesselIdentifier', 120)
        && isValidOptionalString(data, 'authorityEvidenceNote', 600)
        && data.rateKobo is int && data.rateKobo > 0
        && data.cautionFeeKobo is int && data.cautionFeeKobo >= 0
        && data.rentalBasis in ['per_night', 'per_12h_or_24h_day', 'per_hour']
        && isValidStringList(data.featureIds, 30)
        && isValidStringList(data.watermarkedPhotos, 20)
        && (!('privateOriginalMediaRefs' in data) || isValidStringList(data.privateOriginalMediaRefs, 20))
        && (!('duplicateFlagIds' in data) || isValidStringList(data.duplicateFlagIds, 20))
        && (!('verifiedPropertyBadge' in data) || data.verifiedPropertyBadge is bool)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['bookingRef', 'listingId', 'authorDisplayName', 'rating', 'comment', 'moderationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookingRef', 'listingId', 'authorUid', 'authorDisplayName', 'rating', 'comment', 'moderationStatus', 'moderationReason', 'createdAt', 'updatedAt'])
        && isValidId(data.bookingRef)
        && isValidId(data.listingId)
        && isValidOptionalString(data, 'authorUid', 128)
        && isValidString(data.authorDisplayName, 2, 100)
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && isValidString(data.comment, 5, 2000)
        && data.moderationStatus in ['pending', 'approved', 'hidden', 'removed']
        && isValidOptionalString(data, 'moderationReason', 500)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    // --- Collection Rules ---
    // Note: Privileged mutations (approvals, roles, status transitions, payments, ledger entries,
    // availability slots, owner secrets, system config, and audit logs) are strictly denied to
    // client SDKs (`allow write: if false;`) and must execute exclusively through server routes
    // using the Firebase Admin SDK.

    // 1. Users (PII isolated to active owner & Super Admin; role/status changes via server Admin SDK only)
    match /users/{userId} {
      allow get: if isValidId(userId) && ((isOwner(userId) && isActiveUser()) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(userId) && isActiveUser() && isValidUserAccount(incoming()) &&
        isOwner(userId) && incoming().uid == request.auth.uid && incoming().role == 'customer' && incoming().status == 'active';
      allow update: if isValidId(userId) && isActiveUser() && isValidUserAccount(incoming()) &&
        isOwner(userId) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt &&
        incoming().role == existing().role && incoming().status == existing().status &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Partner Profiles (Isolated per active partner; channelVerified & approvals/suspensions via server Admin SDK only)
    match /partnerProfiles/{partnerId} {
      allow get: if isValidId(partnerId) && (isActivePartnerOwner(partnerId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(partnerId) && isActiveUser() && isValidPartnerProfile(incoming()) &&
        isOwner(partnerId) && incoming().ownerUid == request.auth.uid &&
        incoming().channelVerified == false && incoming().verificationStatus == 'pending_review';
      allow update: if isValidId(partnerId) && isActivePartnerOwner(partnerId) && isValidPartnerProfile(incoming()) &&
        incoming().ownerUid == existing().ownerUid && incoming().createdAt == existing().createdAt &&
        incoming().channelVerified == existing().channelVerified &&
        existing().verificationStatus in ['pending_review', 'more_info_requested'] &&
        incoming().verificationStatus == 'pending_review' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['legalName', 'agencyName', 'displayAttribution', 'phone', 'idType', 'privateIdDocRef', 'verificationStatus', 'updatedAt']);
      allow delete: if false;
    }

    // 3. Public Listings (Explicit allow-list, approved only; published exclusively by server Admin SDK on approval)
    match /publicListings/{listingId} {
      allow get: if isValidId(listingId) && existing().status == 'approved';
      allow list: if existing().status == 'approved';
      allow create, update, delete: if false;
    }

    // 4. Private Listings (Active partner isolation; Operational Admin read for coordination; approvals via server Admin SDK)
    match /privateListings/{listingId} {
      allow get: if isValidId(listingId) && (isSuperAdmin() || isOperationalAdmin() || (isActivePartnerOwner(existing().originatorUid)));
      allow list: if isSuperAdmin() || isOperationalAdmin() || (isActivePartnerOwner(existing().originatorUid));
      allow create: if isValidId(listingId) && isApprovedPartner() && isValidPrivateListing(incoming()) &&
        incoming().originatorUid == request.auth.uid && incoming().status == 'pending_review' &&
        (!('verifiedPropertyBadge' in incoming()) || incoming().verifiedPropertyBadge == false);
      allow update: if isValidId(listingId) && isApprovedPartner() && isValidPrivateListing(incoming()) &&
        existing().originatorUid == request.auth.uid &&
        incoming().listingId == existing().listingId && incoming().originatorUid == existing().originatorUid && incoming().createdAt == existing().createdAt &&
        incoming().status == 'pending_review' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'area', 'safeStreetLabel', 'exactBuildingNumber', 'propertyManagerPhone', 'rateKobo', 'cautionFeeKobo', 'featureIds', 'rules', 'specs', 'watermarkedPhotos', 'status', 'updatedAt']);
      allow delete: if false;
    }

    // 5. Legal Owner Secrets (Super Admin read ONLY — Operational Admins strictly blocked; writes via server Admin SDK)
    match /listingOwnerSecrets/{listingId} {
      allow get: if isValidId(listingId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 6. Feature Catalogue (Publicly readable active filters; writes via server Admin SDK)
    match /featureCatalogue/{featureId} {
      allow get: if isValidId(featureId) && (existing().active == true || isSuperAdmin());
      allow list: if existing().active == true || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 7. Bookings (Active customer owner, active partner owner, active operational/super admin read; all writes via server Admin SDK)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isSuperAdmin() ||
        isOperationalAdmin() ||
        (isActiveUser() && existing().customerUid == request.auth.uid) ||
        (isApprovedPartner() && existing().partnerUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || isOperationalAdmin() ||
        (isActiveUser() && existing().customerUid == request.auth.uid) ||
        (isApprovedPartner() && existing().partnerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 8. Availability Slots (Atomic double-booking lock; written exclusively via server Admin SDK transactions)
    match /availabilitySlots/{slotId} {
      allow get: if isValidId(slotId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create, update, delete: if false;
    }

    // 9. Financial Ledger Entries (Active staff-only read; NEVER exposed to guests, customers, or partners; written only by server Admin SDK)
    match /ledgerEntries/{entryId} {
      allow get: if isValidId(entryId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create, update, delete: if false;
    }

    // 10. Official WhatsApp Tickets (Active Operational Admin & Super Admin read; writes via server Admin SDK)
    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create, update, delete: if false;
    }

    // 11. Live Inspections (Active Operational Admin & Super Admin read; writes via server Admin SDK)
    match /inspections/{inspectionId} {
      allow get: if isValidId(inspectionId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create, update, delete: if false;
    }

    // 12. Apartment Reviews (Public reads approved only; verified customer creates pending review; moderation via server Admin SDK)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().moderationStatus == 'approved' || isSuperAdmin() || isOperationalAdmin() || (isActiveUser() && existing().authorUid == request.auth.uid));
      allow list: if existing().moderationStatus == 'approved' || isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(reviewId) && isActiveUser() && isValidReview(incoming()) &&
        incoming().authorUid == request.auth.uid && incoming().moderationStatus == 'pending';
      allow update, delete: if false;
    }

    // 13. Support Issues (Active Operational Admin & Super Admin read; writes via server Admin SDK)
    match /supportIssues/{issueId} {
      allow get: if isValidId(issueId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create, update, delete: if false;
    }

    // 14. Immutable Audit Logs (Super Admin read only; append-only via server Admin SDK; zero client writes/updates/deletes)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 15. System Config (Active Operational Admin & Super Admin read; mutations via server Admin SDK only)
    match /systemConfig/{configId} {
      allow get: if isValidId(configId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 16. Identity Documents (Authorised Super Admin reviewers only; zero client writes)
    match /identityDocuments/{docId} {
      allow get: if isValidId(docId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 17. Verified Customer Saved Profiles (Strictly isolated to owning active customer; writes via server Admin SDK)
    match /customerProfiles/{customerId} {
      allow get: if isValidId(customerId) && ((isOwner(customerId) && isActiveUser()) || isSuperAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 18. Payments (Staff-only read; zero client writes; server Paystack webhook/verify only)
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create, update, delete: if false;
    }

    // 19. Customer Receipts (Active customer owner & active staff read; zero client writes)
    match /receipts/{receiptId} {
      allow get: if isValidId(receiptId) && (
        isSuperAdmin() ||
        isOperationalAdmin() ||
        (isActiveUser() && existing().customerUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || isOperationalAdmin() ||
        (isActiveUser() && existing().customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
