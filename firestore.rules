rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'stephenmayowa112@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isOperationalAdmin() {
      return isSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operational_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isApprovedPartner() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/partnerProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partnerProfiles/$(request.auth.uid)).data.verificationStatus == 'approved' &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringList(val, maxItems) {
      return val is list && val.size() <= maxItems && (val.size() == 0 || val[0] is string);
    }

    // --- Validation Blueprints ---
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'role', 'status', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'role', 'status', 'displayName', 'email', 'phone', 'mfaEnforced', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.role in ['customer', 'partner', 'operational_admin', 'super_admin']
        && data.status in ['active', 'pending_review', 'suspended', 'deactivated']
        && isValidString(data.displayName, 1, 120)
        && isValidString(data.email, 3, 254)
        && isValidOptionalString(data, 'phone', 30)
        && (!('mfaEnforced' in data) || data.mfaEnforced is bool)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidPartnerProfile(data) {
      return data.keys().hasAll(['ownerUid', 'partnerType', 'legalName', 'displayAttribution', 'email', 'phone', 'channelVerified', 'idType', 'privateIdDocRef', 'verificationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'partnerType', 'legalName', 'agencyName', 'displayAttribution', 'email', 'phone', 'channelVerified', 'idType', 'privateIdDocRef', 'verificationStatus', 'reviewNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.partnerType in ['agent', 'owner', 'manager']
        && isValidString(data.legalName, 2, 140)
        && isValidOptionalString(data, 'agencyName', 140)
        && isValidString(data.displayAttribution, 2, 80)
        && isValidString(data.email, 3, 254)
        && isValidString(data.phone, 7, 30)
        && data.channelVerified is bool
        && data.idType in ['nin_slip', 'international_passport', 'drivers_licence', 'pvc']
        && isValidString(data.privateIdDocRef, 3, 260)
        && data.verificationStatus in ['pending_review', 'more_info_requested', 'approved', 'rejected', 'suspended']
        && isValidOptionalString(data, 'reviewNotes', 1000)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidPublicListing(data) {
      return data.keys().hasAll(['listingId', 'category', 'status', 'title', 'summary', 'city', 'area', 'rateKobo', 'rentalBasis', 'cautionFeeKobo', 'currency', 'originatorPartnerId', 'originatorDisplayName', 'verifiedPropertyBadge', 'watermarkedPhotos', 'featureIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['listingId', 'category', 'status', 'title', 'summary', 'city', 'area', 'safeStreetLabel', 'rateKobo', 'rentalBasis', 'cautionFeeKobo', 'currency', 'originatorPartnerId', 'originatorDisplayName', 'verifiedPropertyBadge', 'watermarkedPhotos', 'watermarkedVideoUrl', 'featureIds', 'rules', 'specs', 'averageRating', 'reviewCount', 'createdAt', 'updatedAt'])
        && isValidId(data.listingId)
        && data.category in ['apartment', 'car', 'boat']
        && data.status == 'approved'
        && isValidString(data.title, 4, 160)
        && isValidString(data.summary, 10, 2000)
        && isValidString(data.city, 2, 80)
        && isValidString(data.area, 2, 120)
        && isValidOptionalString(data, 'safeStreetLabel', 120)
        && data.rateKobo is int && data.rateKobo > 0
        && data.rentalBasis in ['per_night', 'per_12h_or_24h_day', 'per_hour']
        && data.cautionFeeKobo is int && data.cautionFeeKobo >= 0
        && data.currency == 'NGN'
        && isValidString(data.originatorPartnerId, 1, 128)
        && isValidString(data.originatorDisplayName, 2, 80)
        && data.verifiedPropertyBadge is bool
        && isValidStringList(data.watermarkedPhotos, 20)
        && isValidOptionalString(data, 'watermarkedVideoUrl', 500)
        && isValidStringList(data.featureIds, 30)
        && (!('averageRating' in data) || (data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0))
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidPrivateListing(data) {
      return data.keys().hasAll(['listingId', 'originatorUid', 'originatorDisplayName', 'category', 'status', 'title', 'summary', 'city', 'area', 'rateKobo', 'cautionFeeKobo', 'rentalBasis', 'featureIds', 'watermarkedPhotos', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['listingId', 'originatorUid', 'originatorDisplayName', 'category', 'status', 'title', 'summary', 'city', 'area', 'safeStreetLabel', 'exactBuildingNumber', 'propertyManagerPhone', 'vehicleOrVesselIdentifier', 'authorityEvidenceNote', 'rateKobo', 'cautionFeeKobo', 'rentalBasis', 'featureIds', 'rules', 'specs', 'watermarkedPhotos', 'privateOriginalMediaRefs', 'duplicateFlagIds', 'verifiedPropertyBadge', 'createdAt', 'updatedAt'])
        && isValidId(data.listingId)
        && isValidId(data.originatorUid)
        && isValidString(data.originatorDisplayName, 2, 80)
        && data.category in ['apartment', 'car', 'boat']
        && data.status in ['pending_review', 'approved', 'changes_requested', 'rejected', 'suspended']
        && isValidString(data.title, 4, 160)
        && isValidString(data.summary, 10, 2000)
        && isValidString(data.city, 2, 80)
        && isValidString(data.area, 2, 120)
        && isValidOptionalString(data, 'safeStreetLabel', 120)
        && isValidOptionalString(data, 'exactBuildingNumber', 120)
        && isValidOptionalString(data, 'propertyManagerPhone', 30)
        && isValidOptionalString(data, 'vehicleOrVesselIdentifier', 120)
        && isValidOptionalString(data, 'authorityEvidenceNote', 600)
        && data.rateKobo is int && data.rateKobo > 0
        && data.cautionFeeKobo is int && data.cautionFeeKobo >= 0
        && data.rentalBasis in ['per_night', 'per_12h_or_24h_day', 'per_hour']
        && isValidStringList(data.featureIds, 30)
        && isValidStringList(data.watermarkedPhotos, 20)
        && (!('privateOriginalMediaRefs' in data) || isValidStringList(data.privateOriginalMediaRefs, 20))
        && (!('duplicateFlagIds' in data) || isValidStringList(data.duplicateFlagIds, 20))
        && (!('verifiedPropertyBadge' in data) || data.verifiedPropertyBadge is bool)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidListingOwnerSecret(data) {
      return data.keys().hasAll(['listingId', 'ownershipClaimStatus', 'updatedAt'])
        && data.keys().hasOnly(['listingId', 'legalOwnerName', 'legalOwnerPhone', 'legalOwnerEmail', 'ownershipClaimStatus', 'updatedAt'])
        && isValidId(data.listingId)
        && isValidOptionalString(data, 'legalOwnerName', 140)
        && isValidOptionalString(data, 'legalOwnerPhone', 30)
        && isValidOptionalString(data, 'legalOwnerEmail', 254)
        && data.ownershipClaimStatus in ['none', 'claim_pending', 'verified_owner_assigned', 'rejected']
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidFeatureCatalogueItem(data) {
      return data.keys().hasAll(['featureId', 'label', 'group', 'active', 'synonyms', 'sortOrder', 'updatedAt'])
        && data.keys().hasOnly(['featureId', 'label', 'group', 'active', 'synonyms', 'sortOrder', 'updatedAt'])
        && isValidId(data.featureId)
        && isValidString(data.label, 2, 80)
        && data.group in ['entertainment', 'views', 'arrangement', 'service', 'booking_payment', 'house_rules']
        && data.active is bool
        && isValidStringList(data.synonyms, 20)
        && data.sortOrder is int && data.sortOrder >= 0
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['bookingRef', 'listingId', 'listingTitle', 'category', 'customerContact', 'customerName', 'startIso', 'endIso', 'units', 'rentalPrincipalKobo', 'serviceChargeKobo', 'cautionFeeKobo', 'extrasKobo', 'customerTotalKobo', 'currency', 'status', 'paymentVerified', 'cautionDepositStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookingRef', 'listingId', 'listingTitle', 'category', 'customerUid', 'customerContact', 'customerName', 'assignedAdminUid', 'partnerUid', 'startIso', 'endIso', 'units', 'rentalPrincipalKobo', 'serviceChargeKobo', 'cautionFeeKobo', 'extrasKobo', 'customerTotalKobo', 'currency', 'status', 'paymentReference', 'paymentVerified', 'cautionDepositStatus', 'createdAt', 'updatedAt'])
        && isValidId(data.bookingRef)
        && isValidId(data.listingId)
        && isValidString(data.listingTitle, 2, 160)
        && data.category in ['apartment', 'car', 'boat']
        && isValidOptionalString(data, 'customerUid', 128)
        && isValidString(data.customerContact, 4, 254)
        && isValidString(data.customerName, 2, 120)
        && isValidOptionalString(data, 'assignedAdminUid', 128)
        && isValidOptionalString(data, 'partnerUid', 128)
        && isValidString(data.startIso, 10, 40)
        && isValidString(data.endIso, 10, 40)
        && data.units is int && data.units > 0
        && data.rentalPrincipalKobo is int && data.rentalPrincipalKobo >= 0
        && data.serviceChargeKobo is int && data.serviceChargeKobo > 0
        && data.cautionFeeKobo is int && data.cautionFeeKobo >= 0
        && data.extrasKobo is int && data.extrasKobo >= 0
        && data.customerTotalKobo is int && data.customerTotalKobo == (data.rentalPrincipalKobo + data.serviceChargeKobo + data.cautionFeeKobo + data.extrasKobo)
        && data.currency == 'NGN'
        && data.status in ['requested', 'quoted', 'awaiting_payment', 'confirmed', 'checked_in', 'checked_out', 'completed', 'cancelled', 'refunded_disputed']
        && isValidOptionalString(data, 'paymentReference', 120)
        && data.paymentVerified is bool
        && data.cautionDepositStatus in ['not_applicable', 'pending_collection', 'collected', 'release_proposed', 'deduction_proposed', 'refunded', 'disputed']
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidAvailabilitySlot(data) {
      return data.keys().hasAll(['slotKey', 'listingId', 'bookingRef', 'holdType', 'createdAt'])
        && data.keys().hasOnly(['slotKey', 'listingId', 'bookingRef', 'holdType', 'expiresAtIso', 'createdAt'])
        && isValidId(data.slotKey)
        && isValidId(data.listingId)
        && isValidId(data.bookingRef)
        && data.holdType in ['hold', 'confirmed']
        && isValidOptionalString(data, 'expiresAtIso', 40)
        && isValidString(data.createdAt, 10, 40);
    }

    function isValidLedgerEntry(data) {
      return data.keys().hasAll(['bookingRef', 'category', 'amountKobo', 'currency', 'settlementStatus', 'createdAt'])
        && data.keys().hasOnly(['bookingRef', 'category', 'amountKobo', 'currency', 'settlementStatus', 'coordinatingAdminUid', 'paystackReference', 'notes', 'createdAt'])
        && isValidId(data.bookingRef)
        && data.category in ['rental_principal', 'service_charge_gross', 'coordinating_admin_allocation', 'founder_allocation', 'ads_ops_allocation', 'caution_deposit_liability', 'caution_refund_payout']
        && data.amountKobo is int && data.amountKobo >= 0
        && data.currency == 'NGN'
        && data.settlementStatus in ['pending', 'collected', 'payable', 'paid', 'disputed']
        && isValidOptionalString(data, 'coordinatingAdminUid', 128)
        && isValidOptionalString(data, 'paystackReference', 120)
        && isValidOptionalString(data, 'notes', 500)
        && isValidString(data.createdAt, 10, 40);
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['ticketRef', 'customerContact', 'status', 'lastMessageText', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ticketRef', 'listingId', 'listingTitle', 'customerContact', 'customerName', 'assignedAdminUid', 'status', 'lastMessageText', 'internalNotes', 'providerMessageIds', 'createdAt', 'updatedAt'])
        && isValidId(data.ticketRef)
        && isValidOptionalString(data, 'listingId', 64)
        && isValidOptionalString(data, 'listingTitle', 160)
        && isValidString(data.customerContact, 4, 120)
        && isValidOptionalString(data, 'customerName', 120)
        && isValidOptionalString(data, 'assignedAdminUid', 128)
        && data.status in ['open', 'in_progress', 'quoted', 'closed']
        && isValidString(data.lastMessageText, 1, 1000)
        && isValidOptionalString(data, 'internalNotes', 2000)
        && (!('providerMessageIds' in data) || isValidStringList(data.providerMessageIds, 50))
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidInspection(data) {
      return data.keys().hasAll(['inspectionRef', 'listingId', 'listingTitle', 'customerContact', 'customerName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['inspectionRef', 'listingId', 'listingTitle', 'customerContact', 'customerName', 'assignedAdminUid', 'scheduledAtIso', 'meetingUrl', 'participants', 'status', 'outcomeNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.inspectionRef)
        && isValidId(data.listingId)
        && isValidString(data.listingTitle, 2, 160)
        && isValidString(data.customerContact, 4, 254)
        && isValidString(data.customerName, 2, 120)
        && isValidOptionalString(data, 'assignedAdminUid', 128)
        && isValidOptionalString(data, 'scheduledAtIso', 40)
        && isValidOptionalString(data, 'meetingUrl', 500)
        && (!('participants' in data) || isValidStringList(data.participants, 10))
        && data.status in ['requested', 'scheduled', 'completed', 'cancelled', 'no_show']
        && isValidOptionalString(data, 'outcomeNotes', 1000)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['bookingRef', 'listingId', 'authorDisplayName', 'rating', 'comment', 'moderationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookingRef', 'listingId', 'authorUid', 'authorDisplayName', 'rating', 'comment', 'moderationStatus', 'moderationReason', 'createdAt', 'updatedAt'])
        && isValidId(data.bookingRef)
        && isValidId(data.listingId)
        && isValidOptionalString(data, 'authorUid', 128)
        && isValidString(data.authorDisplayName, 2, 100)
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && isValidString(data.comment, 5, 2000)
        && data.moderationStatus in ['pending', 'approved', 'hidden', 'removed']
        && isValidOptionalString(data, 'moderationReason', 500)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidSupportIssue(data) {
      return data.keys().hasAll(['bookingRef', 'listingId', 'severity', 'summary', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookingRef', 'listingId', 'assignedAdminUid', 'severity', 'summary', 'status', 'resolutionNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.bookingRef)
        && isValidId(data.listingId)
        && isValidOptionalString(data, 'assignedAdminUid', 128)
        && data.severity in ['low', 'medium', 'high', 'escalated_super_admin']
        && isValidString(data.summary, 5, 500)
        && data.status in ['open', 'escalated', 'closed']
        && isValidOptionalString(data, 'resolutionNotes', 1000)
        && isValidString(data.createdAt, 10, 40)
        && isValidString(data.updatedAt, 10, 40);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorRole', 'action', 'targetType', 'targetId', 'reason', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorRole', 'action', 'targetType', 'targetId', 'reason', 'beforeSummary', 'afterSummary', 'createdAt'])
        && isValidId(data.actorUid)
        && data.actorRole in ['partner', 'operational_admin', 'super_admin', 'system']
        && isValidString(data.action, 2, 100)
        && isValidString(data.targetType, 2, 60)
        && isValidString(data.targetId, 1, 128)
        && isValidString(data.reason, 2, 600)
        && isValidOptionalString(data, 'beforeSummary', 1500)
        && isValidOptionalString(data, 'afterSummary', 1500)
        && isValidString(data.createdAt, 10, 40);
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['operationalAdminCap', 'serviceChargeUnitKobo', 'adminSplitKobo', 'founderSplitKobo', 'adsOpsSplitKobo', 'carPartialDayCutoffHours', 'roundRobinEnabled', 'videoWatermarkEnabled', 'identityDocRetentionDays', 'officialWhatsAppNumber', 'updatedAt'])
        && data.keys().hasOnly(['operationalAdminCap', 'serviceChargeUnitKobo', 'adminSplitKobo', 'founderSplitKobo', 'adsOpsSplitKobo', 'carPartialDayCutoffHours', 'roundRobinEnabled', 'videoWatermarkEnabled', 'identityDocRetentionDays', 'officialWhatsAppNumber', 'updatedAt'])
        && data.operationalAdminCap is int && data.operationalAdminCap >= 1 && data.operationalAdminCap <= 200
        && data.serviceChargeUnitKobo is int && data.serviceChargeUnitKobo > 0
        && data.adminSplitKobo is int && data.founderSplitKobo is int && data.adsOpsSplitKobo is int
        && (data.adminSplitKobo + data.founderSplitKobo + data.adsOpsSplitKobo) == data.serviceChargeUnitKobo
        && data.carPartialDayCutoffHours is int && data.carPartialDayCutoffHours >= 1 && data.carPartialDayCutoffHours <= 24
        && data.roundRobinEnabled is bool
        && data.videoWatermarkEnabled is bool
        && data.identityDocRetentionDays is int && data.identityDocRetentionDays >= 30 && data.identityDocRetentionDays <= 3650
        && isValidString(data.officialWhatsAppNumber, 6, 30)
        && isValidString(data.updatedAt, 10, 40);
    }

    // --- Collection Rules ---

    // 1. Users (PII isolated to owner & Super Admin; prevent self-role-escalation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserAccount(incoming()) && (
        isSuperAdmin() ||
        (isOwner(userId) && incoming().uid == request.auth.uid && incoming().role == 'customer' && incoming().status == 'active')
      );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserAccount(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOwner(userId) && incoming().role == existing().role && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 2. Partner Profiles (Strictly isolated per partner; Super Admin reviews)
    match /partnerProfiles/{partnerId} {
      allow get: if isValidId(partnerId) && (isOwner(partnerId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(partnerId) && isVerifiedUser() && isValidPartnerProfile(incoming()) && (
        isSuperAdmin() ||
        (isOwner(partnerId) && incoming().ownerUid == request.auth.uid && incoming().verificationStatus == 'pending_review')
      );
      allow update: if isValidId(partnerId) && isVerifiedUser() && isValidPartnerProfile(incoming()) && incoming().ownerUid == existing().ownerUid && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOwner(partnerId) && existing().verificationStatus in ['pending_review', 'more_info_requested'] && incoming().verificationStatus == 'pending_review' && incoming().diff(existing()).affectedKeys().hasOnly(['legalName', 'agencyName', 'displayAttribution', 'phone', 'channelVerified', 'idType', 'privateIdDocRef', 'verificationStatus', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 3. Public Listings (Explicit allow-list, approved only, Super Admin writes only)
    match /publicListings/{listingId} {
      allow get: if isValidId(listingId) && existing().status == 'approved';
      allow list: if existing().status == 'approved';
      allow create: if isValidId(listingId) && isSuperAdmin() && isValidPublicListing(incoming());
      allow update: if isValidId(listingId) && isSuperAdmin() && isValidPublicListing(incoming()) && incoming().listingId == existing().listingId;
      allow delete: if isValidId(listingId) && isSuperAdmin();
    }

    // 4. Private Listings (Partner isolation; Operational Admin read for coordination; Super Admin full control)
    match /privateListings/{listingId} {
      allow get: if isValidId(listingId) && (isSuperAdmin() || isOperationalAdmin() || (isVerifiedUser() && existing().originatorUid == request.auth.uid));
      allow list: if isSuperAdmin() || isOperationalAdmin() || (isVerifiedUser() && existing().originatorUid == request.auth.uid);
      allow create: if isValidId(listingId) && isValidPrivateListing(incoming()) && (
        isSuperAdmin() ||
        (isApprovedPartner() && incoming().originatorUid == request.auth.uid && incoming().status == 'pending_review' && (!('verifiedPropertyBadge' in incoming()) || incoming().verifiedPropertyBadge == false))
      );
      allow update: if isValidId(listingId) && isValidPrivateListing(incoming()) && incoming().listingId == existing().listingId && incoming().originatorUid == existing().originatorUid && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isApprovedPartner() && existing().originatorUid == request.auth.uid && incoming().status == 'pending_review' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'area', 'safeStreetLabel', 'exactBuildingNumber', 'propertyManagerPhone', 'rateKobo', 'cautionFeeKobo', 'featureIds', 'rules', 'specs', 'watermarkedPhotos', 'status', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 5. Legal Owner Secrets (Super Admin ONLY — Operational Admins strictly blocked!)
    match /listingOwnerSecrets/{listingId} {
      allow get: if isValidId(listingId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(listingId) && isSuperAdmin() && isValidListingOwnerSecret(incoming());
      allow update: if isValidId(listingId) && isSuperAdmin() && isValidListingOwnerSecret(incoming()) && incoming().listingId == existing().listingId;
      allow delete: if false;
    }

    // 6. Feature Catalogue (Publicly readable active filters; Super Admin managed)
    match /featureCatalogue/{featureId} {
      allow get: if isValidId(featureId) && (existing().active == true || isSuperAdmin());
      allow list: if existing().active == true || isSuperAdmin();
      allow create: if isValidId(featureId) && isSuperAdmin() && isValidFeatureCatalogueItem(incoming());
      allow update: if isValidId(featureId) && isSuperAdmin() && isValidFeatureCatalogueItem(incoming()) && incoming().featureId == existing().featureId;
      allow delete: if false;
    }

    // 7. Bookings (Owner customer, owning partner summary, assigned operational admin, Super Admin)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isSuperAdmin() ||
        isOperationalAdmin() ||
        (isVerifiedUser() && (existing().customerUid == request.auth.uid || existing().partnerUid == request.auth.uid))
      );
      allow list: if isSuperAdmin() || isOperationalAdmin() || (isVerifiedUser() && (existing().customerUid == request.auth.uid || existing().partnerUid == request.auth.uid));
      allow create: if isValidId(bookingId) && isVerifiedUser() && isValidBooking(incoming()) && (
        isSuperAdmin() ||
        isOperationalAdmin() ||
        (incoming().customerUid == request.auth.uid && incoming().status == 'requested' && incoming().paymentVerified == false)
      );
      allow update: if isValidId(bookingId) && isVerifiedUser() && isValidBooking(incoming()) && incoming().bookingRef == existing().bookingRef && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOperationalAdmin() && !(existing().status in ['completed', 'cancelled', 'refunded_disputed']) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedAdminUid', 'cautionDepositStatus', 'paymentReference', 'paymentVerified', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 8. Availability Slots (Atomic double-booking lock; no overwrites of active confirmed slots)
    match /availabilitySlots/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(slotId) && isVerifiedUser() && isValidAvailabilitySlot(incoming());
      allow update: if isValidId(slotId) && isValidAvailabilitySlot(incoming()) && (isSuperAdmin() || isOperationalAdmin());
      allow delete: if isValidId(slotId) && (isSuperAdmin() || isOperationalAdmin());
    }

    // 9. Financial Ledger Entries (Staff-only; NEVER exposed to guests, customers, or partners)
    match /ledgerEntries/{entryId} {
      allow get: if isValidId(entryId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(entryId) && (isSuperAdmin() || isOperationalAdmin()) && isValidLedgerEntry(incoming());
      allow update: if isValidId(entryId) && isSuperAdmin() && isValidLedgerEntry(incoming()) && incoming().bookingRef == existing().bookingRef && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 10. Official WhatsApp Tickets (Operational Admin & Super Admin)
    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(ticketId) && isVerifiedUser() && isValidTicket(incoming());
      allow update: if isValidId(ticketId) && isValidTicket(incoming()) && incoming().ticketRef == existing().ticketRef && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOperationalAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['listingId', 'listingTitle', 'status', 'lastMessageText', 'internalNotes', 'providerMessageIds', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 11. Live Inspections
    match /inspections/{inspectionId} {
      allow get: if isValidId(inspectionId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(inspectionId) && isVerifiedUser() && isValidInspection(incoming());
      allow update: if isValidId(inspectionId) && isValidInspection(incoming()) && incoming().inspectionRef == existing().inspectionRef && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOperationalAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['scheduledAtIso', 'meetingUrl', 'participants', 'status', 'outcomeNotes', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 12. Apartment Reviews (Public reads approved only; moderation by staff)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().moderationStatus == 'approved' || isSuperAdmin() || isOperationalAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
      allow list: if existing().moderationStatus == 'approved' || isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(reviewId) && isVerifiedUser() && isValidReview(incoming()) && (
        isSuperAdmin() ||
        (incoming().authorUid == request.auth.uid && incoming().moderationStatus == 'pending')
      );
      allow update: if isValidId(reviewId) && isValidReview(incoming()) && incoming().bookingRef == existing().bookingRef && incoming().listingId == existing().listingId && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOperationalAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'moderationReason', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 13. Support Issues
    match /supportIssues/{issueId} {
      allow get: if isValidId(issueId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin() || isOperationalAdmin();
      allow create: if isValidId(issueId) && (isSuperAdmin() || isOperationalAdmin()) && isValidSupportIssue(incoming());
      allow update: if isValidId(issueId) && isValidSupportIssue(incoming()) && incoming().bookingRef == existing().bookingRef && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (isOperationalAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['severity', 'status', 'resolutionNotes', 'updatedAt']))
      );
      allow delete: if false;
    }

    // 14. Immutable Audit Logs (Append-only; never editable or deletable)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(logId) && (isSuperAdmin() || isOperationalAdmin() || isApprovedPartner()) && isValidAuditLog(incoming()) && incoming().actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // 15. System Config (Super Admin write only; public safe read for non-sensitive flags blocked except staff)
    match /systemConfig/{configId} {
      allow get: if isValidId(configId) && (isSuperAdmin() || isOperationalAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(configId) && isSuperAdmin() && isValidSystemConfig(incoming());
      allow update: if isValidId(configId) && isSuperAdmin() && isValidSystemConfig(incoming());
      allow delete: if false;
    }
  }
}
