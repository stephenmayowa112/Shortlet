# GEMINI_API_KEY: Required for server-side Gemini AI API calls (Concierge & Image Studio).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical base URL for Shortlet Connect listing deep links and Paystack callbacks.
APP_URL="http://localhost:3000"

# OFFICIAL_WHATSAPP_NUMBER: Single official Shortlet Connect WhatsApp Business number (E.164 digits without +).
NEXT_PUBLIC_OFFICIAL_WHATSAPP_NUMBER="2348090001234"

# PAYSTACK_SECRET_KEY: Sandbox secret key for server-side Paystack verification and HMAC-SHA512 webhooks.
PAYSTACK_SECRET_KEY="sk_test_sandbox_shortlet_connect"

# VIDEO_WATERMARK_ENABLED: Feature flag controlling async video watermarking (see docs/OPEN_QUESTIONS.md OQ-09).
VIDEO_WATERMARK_ENABLED="false"
