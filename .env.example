# ==============================================================================
# Shortlet Connect V1 — Production & Staging Environment Variables (NO SECRETS)
# ==============================================================================

# Canonical public HTTPS origin for listing deep links, SEO canonicals, sitemap & Paystack callbacks.
APP_URL="https://shortletconnect.ng"

# Single official Shortlet Connect WhatsApp Business number (E.164 digits without +).
NEXT_PUBLIC_OFFICIAL_WHATSAPP_NUMBER="2348090001234"

# Set to "true" ONLY in development/staging to load demo Lagos listings.
# Must remain "false" in production so demo data never auto-loads.
NEXT_PUBLIC_ENABLE_DEMO_SEED="false"

# --- Payments (Paystack) ---
# Set to a real Paystack key (sk_test_... or sk_live_...) to auto-enable LivePaystackAdapter.
# Optional: set PAYSTACK_MODE="sandbox" to force offline sandbox mode during local dev.
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
PAYSTACK_MODE="live"

# --- Security, Sessions & Cron ---
# Secret bearer token protecting scheduled cron jobs (/api/reconciliation/daily, /api/identity-docs/purge, /api/health?detailed=true).
# Generate with: openssl rand -hex 32
RECONCILIATION_CRON_SECRET="replace_with_64_hex_char_cron_secret"

# HMAC-SHA256 signing secret for HttpOnly server sessions (minimum 32 random bytes hex).
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace_with_64_hex_char_session_secret"

# 32-byte hex AES-256-GCM encryption key for private partner identity documents at rest.
# Generate with: openssl rand -hex 32
ID_DOC_ENCRYPTION_KEY="replace_with_64_hex_char_aes256_key"

# --- OTP Delivery (SMS & Email) ---
# Termii Nigeria transactional DND SMS API key & approved Sender ID.
TERMII_API_KEY="replace_with_termii_api_key"
TERMII_SENDER_ID="ShortletCon"

# Resend transactional Email API key & verified sender address.
RESEND_API_KEY="replace_with_resend_api_key"
RESEND_FROM_EMAIL="Shortlet Connect <no-reply@shortletconnect.ng>"

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_CLOUD_ACCESS_TOKEN="replace_with_meta_system_user_token"
WHATSAPP_PHONE_NUMBER_ID="replace_with_whatsapp_phone_number_id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace_with_webhook_verify_token"
WHATSAPP_APP_SECRET="replace_with_meta_app_secret"

# --- Media & Feature Flags ---
# Automated video burn-in is Not Implemented in V1; keep "false" until V2 FFmpeg worker is deployed.
VIDEO_WATERMARK_ENABLED="false"

# --- Production Database ---
# Set when deploying with Supabase / Cloud SQL PostgreSQL (see docs/POSTGRES_MIGRATION.md).
DATABASE_URL=""
